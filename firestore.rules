rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // السماح بالوصول الكامل لجميع المستندات (قواعد مفتوحة تماماً)
    match /{document=**} {
      allow read, write: if true;
    }

    // تصريح إضافي صريح للاستعلامات الشاملة (Collection Group Queries)
    // هذا الجزء ضروري جداً لتعمل صفحة "مراقبة العمليات" بدون أخطاء أذونات
    match /{path=**}/transactions/{transaction} {
      allow read, write: if true;
    }
    
    // تحديث لضمان إعادة النشر التلقائي للقواعد
    // Last Update: Star Mobile System Stable Rules v1.7
  }
}