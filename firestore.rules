
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * وظيفة للتحقق مما إذا كان المستخدم هو مدير النظام
     */
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email == '770326828@shabakat.com' || 
         request.auth.uid == 'wsy8bUcULSYX2J9Q9WyisiFX5ki2');
    }

    /**
     * قاعدة شاملة: السماح بالقراءة والكتابة لجميع المستخدمين المسجلين
     * لضمان عمل التحويل والبحث وإدارة الشبكات بدون قيود
     */
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    /**
     * تخصيص إضافي لضمان صلاحيات المدير المطلقة
     */
    match /clientDebts/{debtId} {
      allow read, write, list: if isAdmin() || request.auth != null;
    }

    match /electricityRequests/{requestId} {
      allow read, write, list: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write, list: if request.auth != null;
    }
    
    match /networks/{networkId} {
      allow read, write: if request.auth != null;
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
